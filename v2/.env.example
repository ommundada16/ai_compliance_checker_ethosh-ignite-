# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------

# --- LLM provider: "ollama" (local) or "groq" (cloud free tier) ---
LLM_PROVIDER=ollama

# --- Ollama (local) ---
# Native endpoint, not the /v1 OpenAI shim. The shim silently drops the
# `think` option, so a reasoning model spends its whole token budget on a
# hidden thinking block and returns EMPTY content with finish_reason=length.
OLLAMA_BASE_URL=http://localhost:11434
#
# Measured on this machine (RTX 3050, 4 GB VRAM), same MDR question:
#   llama3.1:8b  15.6s  answered Article 61   CORRECT
#   qwen3:4b      8.2s  answered Article 3    WRONG, and ignored the schema
#
# qwen3:4b fits in VRAM and is roughly twice as fast, which is why it looked
# like the obvious pick before it was measured. On this domain it is not
# accurate enough to propose gold labels, so the slower model is the default.
OLLAMA_MODEL=llama3.1:8b

# --- Groq (cloud, free tier) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Verified available on the free tier as of this commit. llama-3.3-70b-versatile
# was retired and now 404s. List yours with: client.models.list()
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss models spend tokens on internal reasoning before emitting output,
# so max_tokens must leave room for both or JSON mode fails with an empty body.
GROQ_REASONING_EFFORT=low

# --- Judge model ---
# Must differ from the generator, or the grounding check is circular.
JUDGE_PROVIDER=ollama
JUDGE_MODEL=llama3.1:8b

# --- Qdrant ---
# Embedded by default: the index runs IN-PROCESS against this directory, with
# no server and no Docker Desktop VM. On a 16 GB machine that is worth ~2 GB of
# RAM. Set QDRANT_PATH empty to use a server at QDRANT_URL instead; the calling
# code is identical either way.
#
# Embedded mode holds an exclusive lock on the directory, so only one process
# may use it at a time. That is deliberate -- it makes running several
# evaluation jobs at once impossible rather than merely inadvisable.
QDRANT_PATH=qdrant_local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=mdr_clauses_v2

# --- rate limiting ---
# Groq's free tier allows 8000 tokens per minute. GroqProvider paces itself
# against a rolling window BEFORE sending, because reactive backoff cannot fix
# a per-minute limit -- retrying inside an exhausted window just fails again.
# Raise this only if your account's quota is actually higher.
GROQ_TPM=8000

# --- safety ---
# Evaluation scripts abort cleanly if free RAM drops below this, checked before
# every passage. Three jobs left running at once exhausted a 15.7 GB machine
# and froze the desktop; a batch job that cannot finish should stop and say so.
MEMORY_FLOOR_GB=1.5

# --- Embedding / retrieval models (see requirements.txt for sizes) ---
DENSE_MODEL=BAAI/bge-base-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=BAAI/bge-reranker-base

# --- Retrieval tuning (defaults; overridden by eval sweeps) ---
RETRIEVE_CANDIDATES=25
RERANK_TOP_K=5
