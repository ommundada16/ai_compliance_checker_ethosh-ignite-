# --- python ---
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# --- secrets ---
.env

# --- v1 artefacts ---
*.npy
report.json

# --- v2 artefacts ---
# Model weights, vector storage and run outputs are all reproducible.
# Evaluation RESULTS are committed on purpose (see v2/eval_data/), because the
# whole point of this project is that the numbers are auditable.
.fastembed_cache/
qdrant_storage/
artifacts/
*.log

# --- data ---
# The two sample PDFs are committed so the pipeline runs out of the box.
data/*
!data/guideline.pdf
!data/source_file.pdf

# --- frontend ---
node_modules/
v2/frontend/dist/
v2/frontend/.vite/

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# derived cache, rebuilt on demand from clauses.jsonl + the PDF
v2/eval_data/.span_cache.json

# written at the end of a full v2/tools/propose_labels_llm.py run; committed only
# when complete, never as a partial smoke-test result
v2/eval_data/llm_proposals.jsonl

# embedded qdrant index, rebuilt by v2/tools/score_v2.py --reindex
qdrant_local/

# --- regenerable ---
v2/eval_data/.retrieval_cache.json
v2/frontend/*.tsbuildinfo
docs/COMPARISON.generated.md
